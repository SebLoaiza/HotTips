{
    "name": "hot-tips",
    "version": "1.2.1",
    "description": "HotTips Employee Tip Distribution Application",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SebLoaiza/HotTips.git"
    },
    "keywords": [
        "hottips",
        "tips",
        "employee",
        "electron"
    ],
    "author": "Sebastian Loaiza",
    "license": "ISC",
    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/SebLoaiza/HotTips/issues"
    },
    "homepage": "https://github.com/SebLoaiza/HotTips#readme",
    "dependencies": {
        "debug": "^4.4.3",
        "env-paths": "^3.0.0",
        "graceful-fs": "^4.2.11",
        "ms": "^2.1.3",
        "progress": "^2.0.3",
        "semver": "^7.8.5",
        "sumchecker": "^3.0.1",
        "undici-types": "^7.18.2"
    },
    "devDependencies": {
        "electron": "^43.3.0",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.hottips.app",
        "productName": "Hot Tips",
        "icon": "Cropped.ico",
        "files": [
            "electron/**/*",
            "frontend/**/*",
            "Cropped.ico",
            "package.json"
        ],
        "win": {
            "target": "nsis",
            "icon": "Cropped.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}
